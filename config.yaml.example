# Optional configuration for anki-addons-dataset.
#
# Copy to ~/.anki-addons-dataset.yaml, or pass any path with -c/--config.
# Every key is optional: the values below are the built-in defaults, so an absent
# file and an empty file both behave exactly like this one.
#
# Values resolve as: CLI flag > this file > default.
# "~" and "$VAR" are expanded in paths. An unknown key is an error, not a no-op.

# Where snapshots (history/) and the upload bundle (bundle/) are kept.
# Overridden by -w/--working-dir.
working_dir: ~/anki-addons-dataset

github:
  # Personal access token used by the download and parse steps.
  # No scopes are required for public repositories.
  token_file: ~/.github/token.txt

ai:
  # Used by the `ai` step to generate the short addon summaries. Any OpenAI-compatible
  # endpoint works; the key is read from api_key_file (never from this file).
  endpoint: https://api.deepseek.com
  api_key_file: ~/.config/anki-addons-dataset/deepseek-api-key.txt
  model: deepseek-flash
  # The GitHub README is truncated to this many characters before going into the prompt.
  # Changing it changes the prompt, which invalidates the cached answers: see the `ai` step.
  readme_max_chars: 8000
  # Parallel requests to the AI endpoint. Lower this if the provider rate-limits you.
  workers: 4

huggingface:
  # The dataset the upload step pushes to. Point this at a scratch dataset of your
  # own to try the pipeline without touching the published one.
  repo_id: Ya-Alex/anki-addons
  # The remote folders upload pushes and prunes.
  synced_dirs: [history, latest]
  # Note: the HuggingFace token is NOT configured here. huggingface_hub reads it
  # from the HF_TOKEN environment variable or from `hf auth login`.

sample:
  # Shrink a run to a slice of the dataset, for testing changes against a scratch working
  # directory (-w). Both are unset by default, meaning the whole dataset.
  # Overridden by --sample-addons / --sample-snapshots. A sampled run refuses to upload.
  addons: null      # download/parse only the first N addons, ordered by addon id
  snapshots: null   # ai/parse/report/bundle process only the newest N snapshots

logging:
  # Console level. One of: CRITICAL, ERROR, WARNING, INFO, DEBUG. Overridden by -l/--log-level.
  # The log file always gets DEBUG, whatever this says.
  level: INFO
  format: '%(asctime)-15s %(levelname)-8s [%(threadName)-10s] %(message)s'
  # The log is also appended to this file (parent directories are created). A relative
  # path is resolved against working_dir; `false` turns file logging off.
  file: logs/anki-addons-dataset.log
