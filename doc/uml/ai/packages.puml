@startuml

title Packages Diagram (by AI)

skinparam linetype ortho
skinparam ArrowColor red

folder src {
    folder anki_addons_dataset {
        folder argument
        folder bundle
        folder collector {
            folder ai
            folder ankiforum
            folder ankiweb
            folder github {
                folder handler
            }
            folder overrider
        }
        folder common
        folder config
        folder exporter {
            folder json
            folder parquet
            folder xlsx
        }
        folder facade
        folder huggingface
        folder info
        folder initializer
    }
}

ankiweb --> overrider

argument --> common
argument --> config

bundle --> common
bundle --> huggingface

collector --> common
collector --> config
collector --> exporter

common --> config
config --> common

exporter --> common

facade --> argument
facade --> bundle
facade --> collector
facade --> common
facade --> config
facade --> huggingface
facade --> info
facade --> initializer

huggingface --> common
huggingface --> config

info --> collector
info --> common
info --> config
info --> huggingface

initializer --> common
initializer --> huggingface

@enduml
