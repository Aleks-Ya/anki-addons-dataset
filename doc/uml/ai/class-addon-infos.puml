@startuml

title AddonInfos Domain Model (by AI)

skinparam packageStyle rectangle

class AddonInfos <<NewType>> {
  list[AddonInfo]
}

class AddonInfo <<dataclass>> {
  header : AddonHeader
  page : AddonPage
  github : Optional[GithubInfo]
  forum : Optional[AnkiForumInfo]
  ai : Optional[AiInfo]
}

class AddonHeader <<dataclass>> {
  id : AddonId
  title : AddonTitle
  addon_page_url : URL
  rating : AddonRating
  update_date : UpdateDate
  anki_version : AnkiVersion
}

class AddonPage <<dataclass>> {
  content : HtmlStr
  like_number : int
  dislike_number : int
  branches : list[AddonBranch]
  other_links : list[URL]
  description : AddonDescription
  contact_author_url : Optional[URL]
  ai_declaration_markers : list[str]
  description_language : Optional[LanguageCode]
  description_language_confidence : Optional[float]
}

class AddonBranch <<dataclass>> {
  min_anki_version : AnkiVersion
  max_anki_version : Optional[AnkiVersion]
  updated : date
}

class GithubInfo <<dataclass>> {
  github_links : list[GitHubLink]
  github_repo : Optional[GithubRepo]
  languages : list[LanguageName]
  stars : int
  last_commit : Optional[datetime]
  action_count : Optional[int]
  tests_count : Optional[int]
  license : Optional[SpdxLicense]
  forks : Optional[int]
  open_issues : Optional[int]
  size_kb : Optional[int]
  topics : list[Topic]
  repo_description : Optional[str]
  homepage : Optional[URL]
  archived : Optional[bool]
  pushed_at : Optional[datetime]
  created_at : Optional[datetime]
  primary_language : Optional[LanguageName]
  language_bytes : dict[LanguageName, int]
  manifest : Optional[AddonManifest]
  dependencies : list[DependencyName]
  readme : Optional[GithubReadme]
  ai_tooling_markers : list[str]
}

class AddonManifest <<dataclass>> {
  package : Optional[str]
  name : Optional[str]
  conflicts : list[str]
  min_point_version : Optional[int]
  max_point_version : Optional[int]
  homepage : Optional[str]
  mod : Optional[int]
}

class GitHubLink <<dataclass>> {
  url : URL
  user : GitHubUser
  repo : Optional[GithubRepo]
}

class GitHubUser <<dataclass>> {
  user_name : GithubUserName
  --
  get_url() : URL
}

class GithubRepo <<frozen dataclass>> {
  user : GithubUserName
  repo_name : GithubRepoName
  --
  get_id() : GithubRepoId
  get_url() : URL
}

class AnkiForumInfo <<dataclass>> {
  anki_forum_url : Optional[URL]
  topic_slug : Optional[TopicSlug]
  topic_id : Optional[TopicId]
  last_posted_at : Optional[LastPostedAt]
  posts_count : Optional[PostsCount]
}

class AiInfo <<dataclass>> {
  summary : Optional[AiSummary]
  model : Optional[AiModel]
}

AddonInfos "1" o-- "*" AddonInfo

AddonInfo *-- "1" AddonHeader
AddonInfo *-- "1" AddonPage
AddonInfo o-- "0..1" GithubInfo
AddonInfo o-- "0..1" AnkiForumInfo
AddonInfo o-- "0..1" AiInfo

AddonPage "1" o-- "*" AddonBranch

GithubInfo "1" o-- "*" GitHubLink
GithubInfo o-- "0..1" GithubRepo
GithubInfo o-- "0..1" AddonManifest

GitHubLink *-- "1" GitHubUser
GitHubLink o-- "0..1" GithubRepo

@enduml
