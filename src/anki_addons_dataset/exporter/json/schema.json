{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "anki_web",
      "github"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "anki_web": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "addon_page_url",
          "addon_page_content",
          "contact_author_url",
          "description",
          "rating",
          "update_date",
          "anki_version",
          "branches",
          "links",
          "likes",
          "dislikes",
          "ai_declaration_markers",
          "description_language",
          "description_language_confidence"
        ],
        "patternProperties": {
          "^title$": {
            "type": "string"
          }
        },
        "properties": {
          "addon_page_url": {
            "type": "string"
          },
          "addon_page_content": {
            "type": "string"
          },
          "contact_author_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": "string"
          },
          "rating": {
            "type": "integer"
          },
          "update_date": {
            "type": "string"
          },
          "anki_version": {
            "type": "string"
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "min_version": {
                  "type": "string"
                },
                "max_version": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "updated": {
                  "type": "string"
                }
              },
              "required": [
                "max_version",
                "min_version",
                "updated"
              ]
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likes": {
            "type": "integer"
          },
          "dislikes": {
            "type": "integer"
          },
          "ai_declaration_markers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description_language": {
            "type": [
              "null",
              "string"
            ]
          },
          "description_language_confidence": {
            "type": [
              "null",
              "number"
            ]
          }
        }
      },
      "github": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_count",
              "languages",
              "last_commit",
              "links",
              "repo",
              "stars",
              "tests_count",
              "user"
            ],
            "properties": {
              "user": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stars": {
                "type": "integer"
              },
              "last_commit": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "user": {
                      "type": "string"
                    },
                    "repo": {
                      "type": [
                        "null",
                        "string"
                      ]
                    }
                  },
                  "required": [
                    "repo",
                    "url",
                    "user"
                  ]
                }
              },
              "action_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tests_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "license": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "forks": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "open_issues": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "size_kb": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repo_description": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "homepage": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "archived": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "pushed_at": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "created_at": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "primary_language": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "language_bytes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    }
                  }
                }
              },
              "manifest": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "package": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "name": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "conflicts": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "min_point_version": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "max_point_version": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "homepage": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "mod": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "readme": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "ai_tooling_markers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "forum": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "anki_forum_url"
        ],
        "properties": {
          "anki_forum_url": {
            "type": "string"
          },
          "topic_slug": {
            "type": "string"
          },
          "topic_id": {
            "type": "integer"
          },
          "last_posted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "posts_count": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
